{
  "name": "obsidian-kanban-flow",
  "version": "0.1.0",
  "description": "Personal lightweight Kanban board for Obsidian (Svelte 5).",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "oxlint src tests esbuild.config.mjs",
    "lint:fix": "oxlint --fix src tests esbuild.config.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "version": "node scripts/version-bump.mjs && git add manifest.json"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.19.0"
  },
  "dependencies": {
    "svelte-dnd-action": "^0.9.69"
  },
  "devDependencies": {
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.28.2",
    "esbuild-svelte": "^0.8.2",
    "fast-check": "^4.8.0",
    "obsidian": "^1.5.7-1",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "svelte-preprocess": "^6.0.0",
    "tslib": "^2.6.3",
    "typescript": "^5.4.5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "svelte-preprocess": false,
    "esbuild@0.28.2": true
  }
}
